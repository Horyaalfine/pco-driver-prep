# Flask
SECRET_KEY=change-me-to-a-long-random-string
APP_NAME=PCO Driver Prep
APP_URL=https://your-domain.example

# Database (Railway provides this automatically as DATABASE_URL when you
# attach a PostgreSQL plugin — no need to set it yourself there)
DATABASE_URL=postgresql://user:password@localhost:5432/pco_training

# Pricing model
INITIAL_ACCESS_PRICE_GBP=36.00
INITIAL_ACCESS_DAYS=90
CONTINUATION_PRICE_GBP=5.00

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these two Prices in the Stripe dashboard first:
#   1. A one-off "payment" price for £36 (initial access)
#   2. A recurring monthly "subscription" price for £5 (continuation)
STRIPE_INITIAL_PRICE_ID=price_...
STRIPE_CONTINUATION_PRICE_ID=price_...

# Email (same pattern as FlexLog — Namecheap Private Email or any SMTP host)
MAIL_SERVER=mail.privateemail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=hello@your-domain.example
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=hello@your-domain.example

PRE_EXPIRY_REMINDER_DAYS=5
